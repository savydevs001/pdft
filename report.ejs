════════════════════════════════════════════════════════ -->
<div class="page">
  <header class="ph">
    <div class="ph-logo">
      <div class="logo-badge"><% if (companyLogoUrl) { %><img src="<%= companyLogoUrl %>" alt=""><% } else { %><%= companyInitials %><% } %></div>
      <div class="ph-divider"></div>
      <div class="ph-name"><h1><%= companyName %></h1><p><%= companyTagline %></p></div>
    </div>
    <div class="ph-meta">
      <div class="ph-meta-row"><span class="ph-meta-lbl">Report No.</span><span class="ph-meta-val"><%= reportNumber %></span></div>
      <div class="ph-meta-row"><span class="ph-meta-lbl">Inspected</span><span class="ph-meta-val"><%= inspectionDate %></span></div>
    </div>
  </header>
  <div class="accent-bar"></div>

  <div class="pc">
    <div class="sh"><div class="sh-bar"></div><h2>Client &amp; Site Information</h2><span class="sh-num">Section 02</span></div>
    <div class="client-layout">
      <table class="info-tbl">
        <tr><td class="lbl">File No.</td><td class="val"><%= fileNumber %></td></tr>
        <tr><td class="lbl">Client Name</td><td class="val"><%= clientName %></td></tr>
        <tr><td class="lbl">Property Address</td><td class="val"><%= fullAddress %></td></tr>
        <tr><td class="lbl">Date of Inspection</td><td class="val"><%= inspectionDate %></td></tr>
        <tr><td class="lbl">Time of Inspection</td><td class="val"><%= inspectionTime %></td></tr>
        <tr><td class="lbl">Inspector</td><td class="val"><%= inspectorName %> &nbsp;—&nbsp; <%= inspectorLicense %></td></tr>
        <tr><td class="lbl">People Present</td><td class="val"><%= peoplePresent %></td></tr>
        <tr><td class="lbl">Buyer's Agent</td><td class="val"><%= buyersAgent %></td></tr>
        <tr><td class="lbl">Building Occupied</td><td class="val"><%= buildingOccupied %></td></tr>
        <tr><td class="lbl">Weather / Soil</td><td class="val"><%= weatherConditions %></td></tr>
      </table>
      <div>
        <div class="client-photo">
          <img src="<%= propertyPhotoUrl && propertyPhotoUrl.trim() ? propertyPhotoUrl : 'https://placehold.co/400x260/1C2B3A/5A6A7A?text=Property+Photo' %>" alt="Property">
          <div class="client-photo-label"><%= propertyPhotoLabel || 'Front Elevation' %></div>
        </div>
      </div>
    </div>

    <hr class="sec-rule">

    <div class="sh"><div class="sh-bar"></div><h2>Sewer System Information</h2><span class="sh-num">Section 03</span></div>
    <table class="info-tbl">
      <tr>
        <td class="lbl">Camera Entry / Cleanout</td>
        <td class="val"><%= cleanoutLocation %><% if (cleanoutSize) { %> &nbsp;·&nbsp; <strong><%= cleanoutSize %></strong><% } %></td>
      </tr>
      <tr>
        <td class="lbl">Pipe Material(s)</td>
        <td class="val">
          <% pipeTypes.forEach(function(p) { %><span class="pipe-tag"><%= p %></span><% }) %>
        </td>
      </tr>
      <% if (sewerLength) { %>
      <tr><td class="lbl">Total Run Length</td><td class="val"><%= sewerLength %> ft</td></tr>
      <% } %>
      <% if (cameraDirections) { %>
      <tr><td class="lbl">Camera Direction(s)</td><td class="val"><%- cameraDirections.replace(/\n/g,'<br>') %></td></tr>
      <% } %>
      <% if (hasVideoLinks) { %>
      <tr>
        <td class="lbl">Inspection Videos</td>
        <td class="val">
          <% videoLinks.forEach(function(v) { %>
          <a href="<%= v.url %>" class="video-link" target="_blank"><%= v.label %></a>
          <% }) %>
        </td>
      </tr>
      <% } %>
      <% if (systemNotes && systemNotes.trim()) { %>
      <tr><td class="lbl">System Notes</td><td class="val"><%= systemNotes %></td></tr>
      <% } %>
    </table>
  </div>

  <footer class="pf">
    <span class="pf-co"><%= companyName %></span>
    <span class="pf-leg"><%= footerLegal %></span>
    <span class="pf-pg">PAGE <strong>04</strong></span>
  </footer>
</div>



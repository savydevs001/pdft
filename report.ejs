<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>
    <%= reportNumber %> — <%= fullAddress %>
  </title>
  <style>
    :root {
      /* ── Theme (injected at render time) ── */
      <%=__themeCSS %>
      /* ── Body palette ── */
      --color-page-bg: #FFFFFF;
      --color-body-text: #1C2B3A;
      --color-muted: #5A6A7A;
      --color-border: #D8E3EC;
      --color-row-alt: #F4F8FB;

      /* ── Severity ── */
      --sev-none-clr: #2D7A4F;
      --sev-none-bg: #EAF7EF;
      --sev-minor-clr: #B58A00;
      --sev-minor-bg: #FEFAE8;
      --sev-mod-clr: #C0520A;
      --sev-mod-bg: #FEF3EA;
      --sev-major-clr: #B91C1C;
      --sev-major-bg: #FEF0F0;
      --sev-maint-clr: #1D4ED8;
      --sev-maint-bg: #EEF3FF;

      /* ── Typography ── */
      --font: 'Arial', 'Helvetica Neue', sans-serif;

      /* ── Page — US Letter ── */
      --page-w: 8.5in;
      --page-h: 11in;
      --ph: 0.60in;
      /* horizontal padding */
      --pv: 0.50in;
      /* vertical padding */
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font);
      font-size: 9.5pt;
      color: var(--color-body-text);
      background: #8C9BA8;
      line-height: 1.55;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* ══ PAGE SHELL ══════════════════════════════════════════════════ */
    .page {
      width: var(--page-w);
      min-height: var(--page-h);
      background: var(--color-page-bg);
      margin: 20px auto;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 4px 32px rgba(0, 0, 0, .28);
      page-break-after: always;
    }

    @media print {
      body {
        background: none;
      }

      .page {
        margin: 0;
        box-shadow: none;
        page-break-after: always;
      }
    }

    /* ══ SHARED HEADER ═══════════════════════════════════════════════ */
    .ph {
      background: var(--color-header-bg);
      color: var(--color-header-text);
      padding: 10px var(--ph);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }

    .ph-logo {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-badge {
      width: 38px;
      height: 38px;
      border-radius: 7px;
      background: var(--color-logo-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 13px;
      color: #fff;
      letter-spacing: -.5px;
      flex-shrink: 0;
      overflow: hidden;
    }

    .logo-badge img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .ph-divider {
      width: 1px;
      height: 30px;
      background: rgba(255, 255, 255, .22);
    }

    .ph-name h1 {
      font-size: 11pt;
      font-weight: 800;
      letter-spacing: .01em;
    }

    .ph-name p {
      font-size: 7pt;
      opacity: .72;
      margin-top: 1px;
    }

    .ph-meta {
      text-align: right;
    }

    .ph-meta-row {
      display: flex;
      align-items: center;
      gap: 6px;
      justify-content: flex-end;
    }

    .ph-meta-lbl {
      font-size: 6.5pt;
      opacity: .62;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .ph-meta-val {
      font-size: 8pt;
      font-weight: 700;
    }

    .accent-bar {
      height: 3px;
      background: linear-gradient(90deg, var(--color-accent), var(--color-accent-dark));
      flex-shrink: 0;
    }

    /* ══ PAGE CONTENT WRAPPER ════════════════════════════════════════ */
    .pc {
      flex: 1;
      padding: var(--pv) var(--ph);
      overflow: hidden;
    }

    /* ══ SECTION HEADING ═════════════════════════════════════════════ */
    .sh {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }

    .sh-bar {
      width: 4px;
      height: 22px;
      background: var(--color-accent);
      border-radius: 2px;
      flex-shrink: 0;
    }

    .sh h2 {
      font-size: 12.5pt;
      font-weight: 800;
      color: var(--color-body-text);
      flex: 1;
    }

    .sh-num {
      font-size: 7pt;
      font-weight: 700;
      color: var(--color-accent);
      letter-spacing: .10em;
      text-transform: uppercase;
    }

    /* ══ SHARED FOOTER (all pages) ═══════════════════════════════════ */
    .pf {
      margin-top: auto;
      border-top: 1px solid var(--color-border);
      padding: 7px var(--ph) 8px;
      flex-shrink: 0;
      background: var(--color-page-bg);
    }

    .pf-top {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 4px;
    }

    .pf-co {
      font-size: 7.5pt;
      font-weight: 800;
      letter-spacing: .07em;
      text-transform: uppercase;
      color: var(--color-body-text);
    }

    .pf-pg {
      font-size: 7pt;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--color-muted);
    }

    .pf-pg strong {
      color: var(--color-body-text);
    }

    .pf-leg {
      font-size: 6pt;
      color: var(--color-muted);
      line-height: 1.6;
    }

    .pf-leg strong {
      font-weight: 700;
      color: var(--color-body-text);
    }

    .pf-copy {
      font-size: 6pt;
      color: var(--color-muted);
      margin-top: 2px;
    }

    /* ══ INFO TABLE ══════════════════════════════════════════════════ */
    .info-tbl {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 8px;
    }

    .info-tbl tr:nth-child(even) td {
      background: var(--color-row-alt);
    }

    .info-tbl td {
      padding: 6px 10px;
      vertical-align: top;
    }

    .info-tbl td.lbl {
      width: 34%;
      font-size: 7.5pt;
      font-weight: 700;
      letter-spacing: .04em;
      text-transform: uppercase;
      color: var(--color-muted);
      white-space: nowrap;
    }

    .info-tbl td.val {
      font-size: 9pt;
      color: var(--color-body-text);
    }

    .sec-rule {
      border: none;
      border-top: 1px solid var(--color-border);
      margin: 18px 0;
    }

    /* ══ PIPE TAGS ═══════════════════════════════════════════════════ */
    .pipe-tag {
      display: inline-block;
      padding: 2px 9px;
      background: var(--color-accent);
      color: #fff;
      font-size: 7.5pt;
      font-weight: 700;
      border-radius: 3px;
      margin: 2px 3px 2px 0;
      letter-spacing: .04em;
    }

    /* ══ VIDEO LINKS ═════════════════════════════════════════════════ */
    .video-link {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      background: var(--color-row-alt);
      border: 1px solid var(--color-border);
      border-radius: 4px;
      color: var(--color-accent);
      font-size: 8pt;
      font-weight: 600;
      text-decoration: none;
      margin: 2px 4px 2px 0;
    }

    .video-link::before {
      content: '▶';
      font-size: 7pt;
    }

    /* ══ TOC ═════════════════════════════════════════════════════════ */
    .toc-list {
      list-style: none;
    }

    .toc-grp {
      font-size: 6.5pt;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--color-accent);
      margin: 14px 0 5px;
    }

    .toc-item {
      display: flex;
      align-items: baseline;
      gap: 0;
      padding: 5px 0;
      border-bottom: 1px solid var(--color-border);
    }

    .toc-lbl {
      font-size: 9.5pt;
      color: var(--color-body-text);
      white-space: nowrap;
    }

    .toc-dots {
      flex: 1;
      border-bottom: 2px dotted var(--color-border);
      margin: 0 8px;
      position: relative;
      top: -3px;
    }

    .toc-pg {
      font-size: 9pt;
      font-weight: 700;
      color: var(--color-body-text);
      white-space: nowrap;
    }

    /* ══ SEVERITY SCALE ══════════════════════════════════════════════ */
    .sev-block {
      display: flex;
      gap: 12px;
      border-left: 4px solid;
      padding: 10px 12px;
      border-radius: 0 5px 5px 0;
      margin-bottom: 10px;
    }

    .sev-block.sev-none {
      border-color: var(--sev-none-clr);
      background: var(--sev-none-bg);
    }

    .sev-block.sev-minor {
      border-color: var(--sev-minor-clr);
      background: var(--sev-minor-bg);
    }

    .sev-block.sev-mod {
      border-color: var(--sev-mod-clr);
      background: var(--sev-mod-bg);
    }

    .sev-block.sev-major {
      border-color: var(--sev-major-clr);
      background: var(--sev-major-bg);
    }

    .sev-block.sev-maint {
      border-color: var(--sev-maint-clr);
      background: var(--sev-maint-bg);
    }

    .sev-icon {
      font-size: 18pt;
      flex-shrink: 0;
      line-height: 1;
    }

    .sev-title {
      font-size: 10pt;
      font-weight: 800;
    }

    .sev-sub {
      font-size: 7.5pt;
      opacity: .7;
      margin-bottom: 4px;
    }

    .sev-body {
      font-size: 8.5pt;
    }

    .sev-eg {
      margin-top: 4px;
      font-style: italic;
      font-size: 7.5pt;
      opacity: .75;
    }

    /* ══ CAMERA LOG TABLE ════════════════════════════════════════════ */
    .obs-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 14px;
    }

    .obs-table thead td {
      background: var(--color-header-bg);
      color: var(--color-header-text);
      font-size: 7pt;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      padding: 6px 10px;
    }

    .obs-table tbody tr {
      border-bottom: 1px solid var(--color-border);
    }

    .obs-table tbody tr:nth-child(even) {
      background: var(--color-row-alt);
    }

    .obs-table td {
      padding: 7px 10px;
      vertical-align: top;
      font-size: 8.5pt;
    }

    .obs-table td.obs-time {
      white-space: nowrap;
      font-weight: 700;
      width: 60px;
    }

    .obs-table td.obs-feet {
      white-space: nowrap;
      width: 55px;
      text-align: center;
    }

    .obs-table td.obs-sev {
      width: 120px;
    }

    .obs-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 7.5pt;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 3px;
    }

    .obs-badge.sev-none {
      color: var(--sev-none-clr);
      background: var(--sev-none-bg);
    }

    .obs-badge.sev-minor {
      color: var(--sev-minor-clr);
      background: var(--sev-minor-bg);
    }

    .obs-badge.sev-mod {
      color: var(--sev-mod-clr);
      background: var(--sev-mod-bg);
    }

    .obs-badge.sev-major {
      color: var(--sev-major-clr);
      background: var(--sev-major-bg);
    }

    .obs-badge.sev-maint {
      color: var(--sev-maint-clr);
      background: var(--sev-maint-bg);
    }

    .obs-photos {
      display: flex;
      gap: 6px;
      margin-top: 6px;
      flex-wrap: wrap;
    }

    .obs-photos img {
      height: 72px;
      width: 96px;
      object-fit: cover;
      border-radius: 3px;
      border: 1px solid var(--color-border);
    }

    /* ══ DEFECT PAGE ═════════════════════════════════════════════════ */
    .defect {
      border: 1px solid var(--color-border);
      border-radius: 6px;
      overflow: hidden;
    }

    .defect-hd {
      display: flex;
    }

    .defect-stripe {
      width: 6px;
      flex-shrink: 0;
    }

    .defect-stripe.stripe-none {
      background: var(--sev-none-clr);
    }

    .defect-stripe.stripe-minor {
      background: var(--sev-minor-clr);
    }

    .defect-stripe.stripe-mod {
      background: var(--sev-mod-clr);
    }

    .defect-stripe.stripe-major {
      background: var(--sev-major-clr);
    }

    .defect-stripe.stripe-maint {
      background: var(--sev-maint-clr);
    }

    .defect-hd-c {
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      padding: 12px 14px;
      background: var(--color-row-alt);
    }

    .defect-num {
      font-size: 7pt;
      font-weight: 700;
      letter-spacing: .10em;
      text-transform: uppercase;
      color: var(--color-muted);
    }

    .defect-ttl {
      font-size: 13pt;
      font-weight: 800;
      color: var(--color-body-text);
      margin: 3px 0;
    }

    .defect-loc {
      font-size: 8pt;
      color: var(--color-muted);
    }

    .defect-loc span {
      font-weight: 700;
      color: var(--color-body-text);
    }

    .defect-badge {
      text-align: center;
      font-size: 8pt;
      font-weight: 700;
      padding: 8px 12px;
      border-radius: 5px;
      flex-shrink: 0;
      line-height: 1.4;
      white-space: nowrap;
    }

    .defect-badge-icon {
      display: block;
      font-size: 16pt;
      margin-bottom: 2px;
    }

    .badge-none {
      color: var(--sev-none-clr);
      background: var(--sev-none-bg);
    }

    .badge-minor {
      color: var(--sev-minor-clr);
      background: var(--sev-minor-bg);
    }

    .badge-mod {
      color: var(--sev-mod-clr);
      background: var(--sev-mod-bg);
    }

    .badge-major {
      color: var(--sev-major-clr);
      background: var(--sev-major-bg);
    }

    .badge-maint {
      color: var(--sev-maint-clr);
      background: var(--sev-maint-bg);
    }

    .defect-body {
      padding: 14px;
      font-size: 9.5pt;
      line-height: 1.6;
    }

    /* ══ PHOTO GRID ══════════════════════════════════════════════════ */
    .photo-grid {
      display: grid;
      gap: 8px;
      margin-top: 14px;
    }

    .photo-grid.cols-1 {
      grid-template-columns: 1fr;
    }

    .photo-grid.cols-2 {
      grid-template-columns: 1fr 1fr;
    }

    .photo-grid.cols-3 {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .photo-cell {
      position: relative;
      border-radius: 4px;
      overflow: hidden;
      border: 1px solid var(--color-border);
    }

    .photo-cell img {
      width: 100%;
      height: 180px;
      object-fit: cover;
      display: block;
    }

    .photo-grid.cols-1 .photo-cell img {
      height: 260px;
    }

    .photo-num {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(13, 33, 55, .62);
      color: #fff;
      font-size: 6.5pt;
      font-weight: 700;
      letter-spacing: .08em;
      text-align: center;
      padding: 3px 0;
    }

    /* ══ RECOMMENDATIONS ═════════════════════════════════════════════ */
    .rec-list {
      list-style: none;
    }

    .rec-item {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      padding: 10px 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 9.5pt;
    }

    .rec-num {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--color-accent);
      color: #fff;
      font-size: 8pt;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .notes {
      font-size: 9.5pt;
      line-height: 1.7;
      color: var(--color-body-text);
    }

    /* ══ STATEMENT OF SERVICE ════════════════════════════════════════ */
    .legal-text {
      font-size: 9pt;
      line-height: 1.75;
      color: var(--color-body-text);
    }

    .legal-text p {
      margin-bottom: 12px;
    }

    .legal-text p:last-child {
      margin-bottom: 0;
    }

    /* ══ PIPE MATERIALS TABLE ════════════════════════════════════════ */
    .mat-table {
      width: 100%;
      border-collapse: collapse;
    }

    .mat-table thead td {
      background: var(--color-header-bg);
      color: var(--color-header-text);
      font-size: 8pt;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      padding: 8px 14px;
    }

    .mat-table tbody tr:nth-child(even) {
      background: var(--color-row-alt);
    }

    .mat-table tbody td {
      padding: 6px 14px;
      font-size: 9pt;
      border-bottom: 1px solid var(--color-border);
    }

    .mat-table tbody td:last-child {
      font-weight: 700;
      text-align: right;
      color: var(--color-accent);
    }

    .mat-note {
      margin-top: 14px;
      padding: 10px 14px;
      background: var(--color-row-alt);
      border-left: 4px solid var(--color-accent);
      border-radius: 0 4px 4px 0;
      font-size: 8.5pt;
      line-height: 1.6;
    }

    .mat-note strong {
      display: block;
      margin-bottom: 4px;
    }

    /* ══ DEFECTS GRAPHIC PAGE ════════════════════════════════════════ */
    .graphic-wrap {
      width: 100%;
      margin-top: 10px;
    }

    .graphic-wrap img {
      width: 100%;
      border-radius: 5px;
      border: 1px solid var(--color-border);
    }

    /* ══ INSPECTOR BIO ════════════════════════════════════════════════ */
    .bio-headline {
      font-size: 9.5pt;
      line-height: 1.7;
      margin-bottom: 14px;
    }

    .bio-section {
      margin-bottom: 16px;
    }

    .bio-section h3 {
      font-size: 9pt;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: var(--color-muted);
      margin-bottom: 7px;
    }

    .bio-list {
      list-style: none;
    }

    .bio-list li {
      padding: 4px 0 4px 14px;
      font-size: 9pt;
      line-height: 1.5;
      border-bottom: 1px solid var(--color-border);
      position: relative;
    }

    .bio-list li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: var(--color-accent);
      font-weight: 700;
    }

    .bio-footer {
      margin-top: 20px;
      text-align: center;
      padding-top: 16px;
      border-top: 2px solid var(--color-accent);
    }

    .bio-footer .biz-name {
      font-size: 14pt;
      font-weight: 800;
    }

    .bio-footer .biz-tagline {
      font-size: 9pt;
      color: var(--color-muted);
      margin: 4px 0 8px;
    }

    .bio-footer .biz-contact {
      font-size: 11pt;
      font-weight: 700;
      color: var(--color-accent);
    }

    .bio-footer .biz-web {
      font-size: 9pt;
      color: var(--color-muted);
      text-decoration: underline;
    }


    /* ══ COVER PAGE ══════════════════════════════════════════════════ */

    /* Dedicated cover header — bigger than shared .ph */
    .cover-ph {
      background: var(--color-header-bg);
      color: var(--color-header-text);
      padding: 30px var(--ph);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }

    .cover-ph-logo {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .cover-ph-badge {
      width: 76px;
      height: 76px;
      border-radius: 12px;
      background: var(--color-logo-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 26px;
      color: #fff;
      letter-spacing: -.5px;
      flex-shrink: 0;
      overflow: hidden;
    }

    .cover-ph-badge img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cover-ph-divider {
      width: 1px;
      height: 60px;
      background: rgba(255, 255, 255, .22);
    }

    .cover-ph-name h1 {
      font-size: 22pt;
      font-weight: 900;
      letter-spacing: .02em;
      line-height: 1.1;
    }

    .cover-ph-name p {
      font-size: 11pt;
      opacity: .80;
      margin-top: 4px;
    }

    .cover-ph-meta {
      text-align: right;
    }

    .cover-ph-meta-group {
      margin-bottom: 8px;
    }

    .cover-ph-meta-group:last-child {
      margin-bottom: 0;
    }

    .cover-ph-lbl {
      display: block;
      font-size: 8pt;
      opacity: .70;
      letter-spacing: .12em;
      text-transform: uppercase;
      margin-bottom: 2px;
    }

    .cover-ph-val {
      display: block;
      font-size: 12pt;
      font-weight: 800;
      letter-spacing: .05em;
    }

    /* Photo card — tall, inset, rounded with shadow */
    .cover-photo-card {
      margin: 16px var(--ph) 0;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #D8E4EE;
      box-shadow: 0 4px 20px rgba(0, 0, 0, .16);
      position: relative;
      flex-shrink: 0;
      height: 6.4in;
      background: #1C2B3A;
    }

    .cover-photo-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .cover-photo-label {
      position: absolute;
      bottom: 16px;
      left: 16px;
      background: rgba(13, 33, 55, .82);
      color: #fff;
      font-size: 7pt;
      font-weight: 800;
      letter-spacing: .14em;
      text-transform: uppercase;
      padding: 6px 14px;
      border-radius: 6px;
    }

    /* Timeline — pure CSS, no SVG, no gradients */
    .cover-timeline {
      display: flex;
      align-items: center;
      padding: 16px var(--ph) 0;
      gap: 0;
      flex-shrink: 0;
    }

    .cover-tl-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--color-accent);
      flex-shrink: 0;
      border: 3px solid #fff;
      box-shadow: 0 0 0 1px var(--color-accent);
      position: relative;
      z-index: 2;
    }

    .cover-tl-line {
      flex: 1;
      height: 2px;
      background: var(--color-accent);
      position: relative;
      opacity: 0.6;
      margin: 0 -2px;
      z-index: 1;
    }

    .cover-tl-line::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: -4px;
      height: 10px;
      background: repeating-linear-gradient(90deg, var(--color-accent) 0, var(--color-accent) 1px, transparent 1px, transparent 12.5%);
    }

    .cover-tl-arrow {
      color: var(--color-accent);
      font-size: 14px;
      flex-shrink: 0;
      line-height: 1;
      position: relative;
      z-index: 2;
    }

    /* Address block */
    .cover-address {
      padding: 16px var(--ph) 0;
      flex-shrink: 0;
    }

    .cover-eyebrow {
      font-size: 8pt;
      font-weight: 800;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--color-accent);
      margin-bottom: 6px;
    }

    .cover-street {
      font-size: 38pt;
      font-weight: 800;
      line-height: 1.1;
      color: var(--color-body-text);
      letter-spacing: -.02em;
    }

    .cover-city {
      font-size: 20pt;
      font-weight: 500;
      line-height: 1.2;
      color: var(--color-muted);
      margin-top: 2px;
    }

    /* Meta strip */
    .cover-meta-strip {
      padding: 12px var(--ph) 0;
      font-size: 8.5pt;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--color-muted);
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .cover-meta-strip .dot {
      color: var(--color-accent);
      font-size: 9pt;
      line-height: 1;
    }



    /* ══ PROPERTY PHOTO ON CLIENT PAGE ════════════════════════════════ */
    .client-layout {
      display: grid;
      grid-template-columns: 1fr 200px;
      gap: 16px;
      align-items: start;
    }

    .client-photo {
      border-radius: 5px;
      overflow: hidden;
      border: 1px solid var(--color-border);
    }

    .client-photo img {
      width: 100%;
      height: 130px;
      object-fit: cover;
      display: block;
    }

    .client-photo-label {
      font-size: 6.5pt;
      font-weight: 700;
      letter-spacing: .06em;
      text-align: center;
      padding: 4px;
      background: var(--color-row-alt);
      color: var(--color-muted);
    }
  </style>
</head>


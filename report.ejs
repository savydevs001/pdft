                    <%= d.severityIcon %> &nbsp;Defect <%= d.num %> — <%= d.title %>
                  </span>
                  <span class="toc-dots"></span>
                  <span class="toc-pg">
                    <%= d.pageNum %>
                  </span>
                </li>
                <% }) %>
                  <% } %>


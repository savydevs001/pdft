      <div class="ph-meta-row"><span class="ph-meta-lbl">Inspected</span><span class="ph-meta-val"><%= inspectionDate %></span></div>
    </div>
  </header>
  <div class="accent-bar"></div>

  <div class="pc">
    <div class="sh"><div class="sh-bar"></div><h2>Sewer Pipe Conditions</h2><span class="sh-num">Section 05 — Camera Log</span></div>
    <table class="obs-table">
      <thead>
        <tr>
          <td class="obs-time">Time</td>
          <td class="obs-feet">Feet</td>
          <td class="obs-sev">Condition</td>
          <td>Observation</td>
        </tr>
      </thead>
      <tbody>
        <% observations.forEach(function(o) { %>
        <tr>
          <td class="obs-time"><%= o.time %></td>
          <td class="obs-feet"><%= o.feet %> ft</td>
          <td class="obs-sev">
            <span class="obs-badge sev-<%= o.severityCss %>"><%= o.severityIcon %> <%= o.severityLabel %></span>
          </td>
          <td>
            <%= o.note %>
            <% if (o.photos && o.photos.length > 0) { %>
            <div class="obs-photos">
              <% o.photos.forEach(function(url) { %>
              <img src="<%= url %>" alt="observation photo">
              <% }) %>
            </div>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <footer class="pf">
    <span class="pf-co"><%= companyName %></span>
    <span class="pf-leg"><%= footerLegal %></span>
    <span class="pf-pg">PAGE <strong><%= String(pages.observations).padStart(2,'0') %></strong></span>
  </footer>
</div>
<% } %>


<!-- ════════════════════════════════════════════════════════
     PAGES 7+ — DEFECT FINDINGS (one page per defect)
════════════════════════════════════════════════════════ -->
<% defects.forEach(function(d, i) { %>
<div class="page">
  <header class="ph">
    <div class="ph-logo">
      <div class="logo-badge"><% if (companyLogoUrl) { %><img src="<%= companyLogoUrl %>" alt=""><% } else { %><%= companyInitials %><% } %></div>
      <div class="ph-divider"></div>
      <div class="ph-name"><h1><%= companyName %></h1><p><%= companyTagline %></p></div>
    </div>
    <div class="ph-meta">
      <div class="ph-meta-row"><span class="ph-meta-lbl">Report No.</span><span class="ph-meta-val"><%= reportNumber %></span></div>
      <div class="ph-meta-row"><span class="ph-meta-lbl">Inspected</span><span class="ph-meta-val"><%= inspectionDate %></span></div>
    </div>
  </header>
  <div class="accent-bar"></div>

  <div class="pc">
    <div class="sh">
      <div class="sh-bar"></div>
      <h2>Defect Findings</h2>
      <span class="sh-num">Section <%= hasObservations ? '06' : '05' %> — Finding <%= d.num %> of <%= defectCount %></span>
    </div>

    <div class="defect">
      <div class="defect-hd">
        <div class="defect-stripe stripe-<%= d.severityCss %>"></div>
        <div class="defect-hd-c">
          <div>
            <div class="defect-num">Defect <%= d.num %></div>
            <div class="defect-ttl"><%= d.title %></div>
            <div class="defect-loc">At <span><%= d.time %> min</span> &nbsp;/&nbsp; <span><%= d.feet %> ft</span></div>
          </div>
          <div class="defect-badge badge-<%= d.severityCss %>">
            <span class="defect-badge-icon"><%= d.severityIcon %></span>
            <%= d.severityLabel %><br>
            <span style="font-weight:400;font-size:6.5pt;"><%= d.severitySub %></span>
          </div>
        </div>
      </div>
      <div class="defect-body">
        <%- d.narrative %>
        <div class="photo-grid <%= d.gridClass %>">
          <% d.photos.forEach(function(url, pi) { %>
          <div class="photo-cell">
            <img src="<%= url %>" alt="Photo <%= pi+1 %>">
            <span class="photo-num">PHOTO <%= pi+1 %></span>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <footer class="pf">
    <span class="pf-co"><%= companyName %></span>
    <span class="pf-leg"><%= footerLegal %></span>
    <span class="pf-pg">PAGE <strong><%= d.pageNum %></strong></span>
  </footer>
</div>
<% }) %>



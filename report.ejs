    <div class="ph-meta">
      <div class="ph-meta-row"><span class="ph-meta-lbl">Report No.</span><span class="ph-meta-val"><%= reportNumber %></span></div>
      <div class="ph-meta-row"><span class="ph-meta-lbl">Inspected</span><span class="ph-meta-val"><%= inspectionDate %></span></div>
    </div>
  </header>
  <div class="accent-bar"></div>

  <div class="pc">
    <div class="sh"><div class="sh-bar"></div><h2>Sewer Defects Reference Graphic</h2></div>
    <div class="graphic-wrap">
      <img src="<%= defectsGraphicUrl %>" alt="Common Sewer Line Defects Diagram">
    </div>
  </div>

  <footer class="pf">
    <span class="pf-co"><%= companyName %></span>
    <span class="pf-leg"><%= footerLegal %></span>
    <span class="pf-pg">PAGE <strong><%= String(pages.defectsGraphic).padStart(2,'0') %></strong></span>
  </footer>
</div>
<% } %>


<!-- ════════════════════════════════════════════════════════
     MEET YOUR INSPECTOR (optional)
════════════════════════════════════════════════════════ -->
<% if (showInspectorBio) { %>
<div class="page">
  <header class="ph">
    <div class="ph-logo">
      <div class="logo-badge"><% if (companyLogoUrl) { %><img src="<%= companyLogoUrl %>" alt=""><% } else { %><%= companyInitials %><% } %></div>
      <div class="ph-divider"></div>
      <div class="ph-name"><h1><%= companyName %></h1><p><%= companyTagline %></p></div>
    </div>
    <div class="ph-meta">
      <div class="ph-meta-row"><span class="ph-meta-lbl">Report No.</span><span class="ph-meta-val"><%= reportNumber %></span></div>
      <div class="ph-meta-row"><span class="ph-meta-lbl">Inspected</span><span class="ph-meta-val"><%= inspectionDate %></span></div>
    </div>
  </header>
  <div class="accent-bar"></div>

  <div class="pc">
    <div class="sh"><div class="sh-bar"></div><h2>Meet Your Inspector</h2></div>
    <div style="font-size:10pt;font-weight:800;margin-bottom:8px;"><%= inspectorName %> &nbsp;<span style="font-weight:400;font-size:8.5pt;color:var(--color-muted);">— <%= inspectorLicense %></span></div>

    <% if (inspectorBioHeadline) { %>
    <div class="bio-headline"><%= inspectorBioHeadline %></div>
    <% } %>

    <% if (inspectorCredentials && inspectorCredentials.length > 0) { %>
    <div class="bio-section">
      <h3>Certifications &amp; Training</h3>
      <ul class="bio-list">
        <% inspectorCredentials.forEach(function(c) { %>
        <li><%= c %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>

    <% if (inspectorExperience && inspectorExperience.length > 0) { %>
    <div class="bio-section">
      <h3>Industry Experience</h3>
      <ul class="bio-list">
        <% inspectorExperience.forEach(function(e) { %>
        <li><%= e %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>

    <% if (inspectorWaysAndMeans) { %>
    <div class="bio-section">
      <h3>Ways &amp; Means</h3>
      <div class="legal-text"><p><%= inspectorWaysAndMeans %></p></div>
    </div>
    <% } %>

    <div class="bio-footer">
      <div class="biz-name"><%= companyName %></div>
      <div class="biz-tagline">Proudly Serving Las Vegas &amp; Henderson</div>
      <div class="biz-contact"><%= companyPhone || '' %></div>
      <div class="biz-web"><%= companyWebsite || '' %></div>
    </div>
  </div>

  <footer class="pf">
    <span class="pf-co"><%= companyName %></span>
    <span class="pf-leg"><%= footerLegal %></span>
    <span class="pf-pg">PAGE <strong><%= String(pages.inspectorBio).padStart(2,'0') %></strong></span>
  </footer>
</div>
<% } %>


</body>
</html>
